PORT=8787
DB_PATH=./data/jomworklah.db
FRONTEND_ORIGIN=http://localhost:8080
# Serve the prototype from this API (path is resolved from backend/).
# In this repo the prototype lives two levels up:
# STATIC_DIR=../../jomworklah-temp

# Intelligence provider: "rule" (default, offline) or "openai"
AI_PROVIDER=rule
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT_MS=8000

# Guard for POST /api/dev/reset
ALLOW_DEV_RESET=1

# Optional per-IP rate limiting
RATE_LIMIT=0
RATE_LIMIT_PER_MINUTE=120
