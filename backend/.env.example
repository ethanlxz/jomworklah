PORT=8787
DB_PATH=./data/jomworklah.db
FRONTEND_ORIGIN=http://localhost:8080
# Serve the prototype from this API (path is resolved from backend/).
# In this repo the prototype lives two levels up:
# STATIC_DIR=../../jomworklah-temp

# Intelligence provider: "rule" (default, offline) or "openai"
AI_PROVIDER=rule
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT_MS=8000

# Guard for POST /api/dev/reset
ALLOW_DEV_RESET=1

# Optional per-IP rate limiting
RATE_LIMIT=0
RATE_LIMIT_PER_MINUTE=120

# Alibaba Cloud Model Studio (Qwen) resume extraction for POST /api/parse-resume.
# Live parsing is used as soon as DASHSCOPE_API_KEY is set. Without a key the
# endpoint returns predefined sample data flagged with "is_simulated": true.
DASHSCOPE_API_KEY=
# Either the regional OpenAI-compatible endpoint or the workspace-scoped one
# shown below; use whichever the Model Studio console gives you. qwen-doc-turbo
# is not served by every region, so check the console if extraction returns
# "Model not exist".
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-doc-turbo
# Per-request timeout for upload and extraction, in milliseconds.
QWEN_TIMEOUT_MS=60000

# Resume upload limit in bytes (10 MB).
RESUME_MAX_BYTES=10485760
